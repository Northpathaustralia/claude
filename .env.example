# .env.example — TEMPLATE ONLY. Copy to .env (which is gitignored) and fill real values.
# NEVER commit a real .env. Rotate any key that is ever pasted into chat, a screenshot, or a commit.
# All values below are placeholders. Store production secrets in the platform's secret manager, not here.

# --- Course host / ecommerce (e.g. Stan, Kajabi, Shopify, Podia) ---
COURSE_PLATFORM_API_KEY=changeme
COURSE_PLATFORM_WEBHOOK_SECRET=changeme

# --- Payments (e.g. Stripe) — use the platform's hosted checkout; keep secret key server-side only ---
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_changeme
STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# --- Email marketing (e.g. MailerLite, ConvertKit, Klaviyo) ---
EMAIL_API_KEY=changeme

# --- Analytics (privacy-friendly preferred, e.g. Plausible/Fathom) ---
ANALYTICS_SITE_ID=changeme

# --- Ad platforms (server-side conversions API tokens ONLY; never client-exposed) ---
META_CAPI_TOKEN=changeme
TIKTOK_EVENTS_TOKEN=changeme

# --- AI production (Higgsfield etc.) — do NOT expose in any client bundle ---
HIGGSFIELD_API_KEY=changeme

# --- App ---
NODE_ENV=development
